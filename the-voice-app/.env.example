# Gemini API Key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — override default chat model (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Cal.com — https://app.cal.com → Settings → Developer → API Keys
CAL_API_KEY=
CAL_EVENT_TYPE_ID=

# Vapi web-call widget — https://dashboard.vapi.ai
# Public Key: dashboard → Vapi API Keys → Public Key (safe to expose in browser)
# Assistant ID: dashboard → Assistants → click assistant → copy ID
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
