# OpenAI API Key (required) — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Cal.com API Key (optional — needed for calendar booking)
# Get from: cal.com → Settings → Security → API Keys
CAL_API_KEY=cal_live_your-key-here

# Cal.com Event Type ID (the event type for interview booking)
CAL_EVENT_TYPE_ID=1

# Server port
PORT=3000
